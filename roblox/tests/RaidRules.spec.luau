--!nonstrict
local RaidRules = require("./.build/shared/RaidRules")

return function(t)
	t.case("gear curves", function()
		t.eq(RaidRules.hammerDamage(1), 50)
		t.eq(RaidRules.hammerDamage(2), 75)
		t.eq(RaidRules.sackCapacity(1), 500)
		t.eq(RaidRules.sackCapacity(2), 800)
		t.eq(RaidRules.gearCost(2), 400)
		t.eq(RaidRules.gearCost(3), 680)
	end)

	t.case("levels from xp", function()
		local level, into, need = RaidRules.levelFromXp(0)
		t.eq(level, 1)
		t.eq(into, 0)
		t.eq(need, 100)
		level = RaidRules.levelFromXp(100)
		t.eq(level, 2)
		level = RaidRules.levelFromXp(100 + 303 + 10)
		t.eq(level, 3)
	end)

	t.case("upgrade timers and skips", function()
		t.eq(RaidRules.upgradeSeconds(3), 0)
		t.eq(RaidRules.upgradeSeconds(4), 60)
		t.eq(RaidRules.upgradeSeconds(6), 240)
		t.eq(RaidRules.skipGems(0), 0)
		t.eq(RaidRules.skipGems(1), 1)
		t.eq(RaidRules.skipGems(600), 5)
	end)

	t.case("stealable respects fraction and sack", function()
		t.eq(RaidRules.stealable(1000, 500, 1), 250)
		t.eq(RaidRules.stealable(10000, 500, 1), 500)
		t.eq(RaidRules.stealable(10000, 500, 2), 1000)
		t.eq(RaidRules.stealable(0, 500, 1), 0)
	end)

	t.case("trophies", function()
		t.eq(RaidRules.trophyDelta(true, 5, 5, false), 30)
		t.eq(RaidRules.trophyDelta(true, 20, 5, false), 10)
		t.eq(RaidRules.trophyDelta(true, 1, 20, false), 50)
		t.eq(RaidRules.trophyDelta(false, 5, 5, false), -20)
		t.eq(RaidRules.trophyDelta(true, 5, 5, true), 15)
	end)

	t.case("shield rules", function()
		t.eq(RaidRules.shieldSeconds(0.01), 0)
		t.eq(RaidRules.shieldSeconds(0.1), 3600)
		t.eq(RaidRules.shieldSeconds(0.7), 10800)
	end)

	t.case("bandit loot decays", function()
		t.eq(RaidRules.banditLoot(4, 0), 1400)
		t.eq(RaidRules.banditLoot(4, 10), 700)
		t.eq(RaidRules.banditLoot(4, 50), 700)
		t.eq(RaidRules.recentBanditRaids({ 100, 2000, 5000 }, 5000), 2)
	end)

	t.case("leagues", function()
		t.eq(RaidRules.leagueFor(0).name, "Wood")
		t.eq(RaidRules.leagueFor(650).name, "Silver")
		t.eq(RaidRules.leagueFor(99999).name, "Champion")
		t.eq(RaidRules.nextLeague(650).name, "Gold")
		t.eq(RaidRules.nextLeague(99999), nil)
	end)

	t.case("accrual caps at capacity and offline hours", function()
		local stored, tick = RaidRules.accrue(0, 120, 1000, 1000 + 3600, 2000)
		t.eq(stored, 120)
		t.eq(tick, 4600)
		stored = RaidRules.accrue(1990, 120, 0 + 1, 3601, 2000)
		t.eq(stored, 2000)
		stored = RaidRules.accrue(0, 100, 1, 1 + 100 * 3600, 1000000)
		t.eq(stored, 1200, "12h offline cap")
		local s2, tick2 = RaidRules.accrue(0, 120, 1000, 1000 + 15, 2000)
		t.eq(s2, 0, "no whole coin yet")
		t.eq(tick2, 1000, "tick unchanged until a coin is produced")
	end)

	t.case("walk speed slows with sack fill", function()
		t.near(RaidRules.walkSpeed(0, 1, false), 16, 1e-6)
		t.near(RaidRules.walkSpeed(1, 1, false), 16 * 0.6, 1e-6)
		t.truthy(RaidRules.walkSpeed(1, 5, false) > RaidRules.walkSpeed(1, 1, false))
	end)
end
