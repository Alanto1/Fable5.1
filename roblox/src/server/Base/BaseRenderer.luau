--!nonstrict
-- BaseRenderer: turns a layout into instances inside a plot or an arena.
-- Piece templates live in ReplicatedStorage.Assets.Pieces (generated by tools/gen_props.py).
-- Every spawned piece model carries attributes: PieceIndex, PieceId, Level, HP, MaxHP.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pieces = require(Shared.Data.Pieces)
local Themes = require(Shared.Data.Themes)
local AssetIds = require(Shared.Data.AssetIds)
local Grid = require(Shared.Grid)

local BaseRenderer = {}

local GROUND_OFFSET = 1.0 -- root part centre sits 0.1 above the ground plane, plots are 1 stud thick
local templates = nil

local function getTemplates()
	if templates then
		return templates
	end
	local assets = ReplicatedStorage:WaitForChild("Assets")
	templates = assets:WaitForChild("Pieces")
	return templates
end

function BaseRenderer.pieceCFrame(rootCFrame: CFrame, piece): CFrame
	local def = Pieces.get(piece.id)
	local cx, cz = Grid.localOffset(piece.x, piece.z, def.size.w, def.size.d, piece.r)
	return rootCFrame * CFrame.new(cx, GROUND_OFFSET, cz) * CFrame.Angles(0, Grid.angle(piece.r), 0)
end

function BaseRenderer.recolor(model: Instance, theme: string)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local key = descendant:GetAttribute("ThemeKey")
			if key then
				descendant.Color = Themes.color(theme, key)
			end
		end
	end
end

-- Swap in an uploaded mesh when one exists for this piece (hero art from Blender).
local function applyMesh(model: Model, pieceId: string)
	local meshId = AssetIds.mesh(pieceId)
	if not meshId then
		return
	end
	local root = model.PrimaryPart
	if not root then
		return
	end
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child ~= root then
			child.Transparency = 1
			child.CanCollide = false
		end
	end
	local mesh = Instance.new("MeshPart")
	mesh.Name = "Mesh"
	mesh.MeshId = meshId
	mesh.Anchored = true
	mesh.CFrame = root.CFrame
	mesh.Parent = model
end

function BaseRenderer.buildPiece(index: number, piece, rootCFrame: CFrame, theme: string): Model?
	local def = Pieces.get(piece.id)
	if not def then
		return nil
	end
	local template = getTemplates():FindFirstChild(piece.id)
	if not template then
		warn("[BaseRenderer] no template for " .. piece.id)
		return nil
	end
	local model = template:Clone()
	model.Name = "Piece_" .. index
	model:SetAttribute("PieceIndex", index)
	model:SetAttribute("PieceId", piece.id)
	model:SetAttribute("Level", piece.lvl)
	local maxHp = Pieces.hp(piece.id, piece.lvl)
	model:SetAttribute("MaxHP", maxHp)
	model:SetAttribute("HP", maxHp)
	model:PivotTo(BaseRenderer.pieceCFrame(rootCFrame, piece))
	BaseRenderer.recolor(model, theme)
	applyMesh(model, piece.id)
	return model
end

-- Spawns a whole layout. Returns a handle { Model, Root (CFrame), Pieces = { [index] = { model, piece, def } } }.
function BaseRenderer.spawn(layout, rootCFrame: CFrame, theme: string, parent: Instance, name: string?)
	local container = Instance.new("Model")
	container.Name = name or "Base"
	local handle = { Model = container, Root = rootCFrame, Theme = theme, Pieces = {} }
	for index, piece in layout do
		local model = BaseRenderer.buildPiece(index, piece, rootCFrame, theme)
		if model then
			model.Parent = container
			handle.Pieces[index] = { model = model, piece = piece, def = Pieces.get(piece.id) }
		end
	end
	container.Parent = parent
	return handle
end

function BaseRenderer.setPiece(handle, index: number, piece)
	local existing = handle.Pieces[index]
	if existing and existing.model then
		existing.model:Destroy()
	end
	handle.Pieces[index] = nil
	if piece then
		local model = BaseRenderer.buildPiece(index, piece, handle.Root, handle.Theme)
		if model then
			model.Parent = handle.Model
			handle.Pieces[index] = { model = model, piece = piece, def = Pieces.get(piece.id) }
		end
	end
end

-- Re-index after a removal so piece models keep matching layout indices.
function BaseRenderer.refresh(handle, layout)
	for _, entry in handle.Pieces do
		if entry.model then
			entry.model:Destroy()
		end
	end
	handle.Pieces = {}
	for index, piece in layout do
		local model = BaseRenderer.buildPiece(index, piece, handle.Root, handle.Theme)
		if model then
			model.Parent = handle.Model
			handle.Pieces[index] = { model = model, piece = piece, def = Pieces.get(piece.id) }
		end
	end
end

function BaseRenderer.setTheme(handle, theme: string)
	handle.Theme = theme
	BaseRenderer.recolor(handle.Model, theme)
end

function BaseRenderer.clear(handle)
	if handle and handle.Model then
		handle.Model:Destroy()
	end
end

-- Finds the piece model an instance belongs to (walks up to the model with PieceIndex).
function BaseRenderer.pieceFromInstance(instance: Instance?): Model?
	local current = instance
	while current and current ~= workspace do
		if current:IsA("Model") and current:GetAttribute("PieceIndex") ~= nil then
			return current
		end
		current = current.Parent
	end
	return nil
end

return BaseRenderer
