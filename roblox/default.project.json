{
  "name": "RaidABase",
  "globIgnorePaths": ["**/*.spec.luau", "**/*.md"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Assets": { "$path": "assets/models" },
      "Remotes": { "$className": "Folder" }
    },

    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 50,
        "EnableMouseLockOption": true,
        "AutoJumpEnabled": true
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },

    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ScreenOrientation": "LandscapeSensor"
      }
    },

    "Workspace": {
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 512
      },
      "Map": { "$path": "assets/map" }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.35, 0.36, 0.42],
        "OutdoorAmbient": [0.45, 0.47, 0.55],
        "Brightness": 2.5,
        "ClockTime": 14,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "ShadowSoftness": 0.3,
        "Technology": "ShadowMap"
      },
      "Bloom": { "$className": "BloomEffect", "$properties": { "Intensity": 0.4, "Size": 24, "Threshold": 1.2 } },
      "ColorCorrection": { "$className": "ColorCorrectionEffect", "$properties": { "Saturation": 0.15, "Contrast": 0.08 } },
      "Sky": {
        "$className": "Sky",
        "$properties": { "StarCount": 1000, "SunAngularSize": 12 }
      },
      "Atmosphere": { "$className": "Atmosphere", "$properties": { "Density": 0.28, "Offset": 0.25, "Glare": 0.2, "Haze": 1.2 } }
    },

    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
